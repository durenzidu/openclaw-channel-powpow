{
  "id": "powpow",
  "categories": [
    "channels"
  ],
  "name": "PowPow",
  "description": "PowPow map digital-human chat channel plugin for OpenClaw: Supabase Realtime + history polling inbound, webhook reply outbound.",
  "activation": {
    "onStartup": false
  },
  "channels": [
    "powpow"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "powpow": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "defaultAccount": {
            "type": "string"
          },
          "apiBaseUrl": {
            "type": "string"
          },
          "digitalHumanId": {
            "type": "string"
          },
          "webhookToken": {
            "type": "string"
          },
          "supabaseUrl": {
            "type": "string"
          },
          "supabaseAnonKey": {
            "type": "string"
          },
          "dmPolicy": {
            "type": "string",
            "enum": [
              "pairing",
              "allowlist",
              "open",
              "disabled"
            ]
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "realtimeEnabled": {
            "type": "boolean"
          },
          "pollEnabled": {
            "type": "boolean"
          },
          "pollIntervalMs": {
            "type": "number",
            "minimum": 1000
          },
          "historyLimit": {
            "type": "number",
            "minimum": 1,
            "maximum": 200
          },
          "requestTimeoutMs": {
            "type": "number",
            "minimum": 1000
          },
          "maxRetries": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "maxMessageLength": {
            "type": "number",
            "minimum": 100
          }
        },
        "additionalProperties": false
      },
      "label": "PowPow",
      "description": "Chat as a PowPow map digital human."
    }
  },
  "author": "durenzidu",
  "license": "MIT",
  "homepage": "https://github.com/durenzidu/openclaw-channel-powpow",
  "repository": {
    "type": "git",
    "url": "https://github.com/durenzidu/openclaw-channel-powpow.git"
  },
  "bugs": {
    "url": "https://github.com/durenzidu/openclaw-channel-powpow/issues"
  },
  "keywords": [
    "openclaw",
    "channel",
    "powpow",
    "map",
    "digital-human",
    "supabase",
    "realtime",
    "communication"
  ],
  "clawhub": {
    "tags": [
      "communication",
      "powpow",
      "map",
      "digital-human",
      "supabase",
      "realtime"
    ],
    "features": [
      "Supabase Realtime 实时收信（毫秒级）",
      "chat/history 轮询兜底（Realtime 断连自动降级）",
      "webhook 接口回信（带会话续接与重试）",
      "多媒体消息接收（文本/图片/语音描述）",
      "访问控制（open/allowlist/pairing/disabled）",
      "CLI setup 向导（--digital-human-id/--webhook-token 等）"
    ],
    "documentation": "README.md"
  }
}
