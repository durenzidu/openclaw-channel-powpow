{
  "id": "powpow-channel",
  "categories": [
    "channels"
  ],
  "name": "PowPow",
  "description": "PowPow map digital-human chat channel plugin for OpenClaw: history polling inbound, webhook reply outbound, two-way messaging with map visitors.",
  "activation": {
    "onStartup": false
  },
  "channels": [
    "powpow"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "powpow": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "defaultAccount": {
            "type": "string"
          },
          "apiBaseUrl": {
            "type": "string"
          },
          "digitalHumanId": {
            "type": "string"
          },
          "webhookToken": {
            "type": "string"
          },
          "dmPolicy": {
            "type": "string",
            "enum": [
              "pairing",
              "allowlist",
              "open",
              "disabled"
            ]
          },
          "allowFrom": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "pollEnabled": {
            "type": "boolean"
          },
          "pollIntervalMs": {
            "type": "number",
            "minimum": 1000
          },
          "historyLimit": {
            "type": "number",
            "minimum": 1,
            "maximum": 200
          },
          "requestTimeoutMs": {
            "type": "number",
            "minimum": 1000
          },
          "maxRetries": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "maxMessageLength": {
            "type": "number",
            "minimum": 100
          }
        },
        "additionalProperties": false
      },
      "label": "PowPow",
      "description": "Chat as a PowPow map digital human."
    }
  },
  "author": "durenzidu",
  "license": "MIT",
  "homepage": "https://github.com/durenzidu/openclaw-channel-powpow",
  "repository": {
    "type": "git",
    "url": "https://github.com/durenzidu/openclaw-channel-powpow.git"
  },
  "bugs": {
    "url": "https://github.com/durenzidu/openclaw-channel-powpow/issues"
  },
  "keywords": [
    "openclaw",
    "channel",
    "powpow",
    "map",
    "digital-human",
    "communication",
    "messaging",
    "chat",
    "polling"
  ],
  "clawhub": {
    "tags": [
      "communication",
      "powpow",
      "map",
      "digital-human",
      "messaging",
      "chat"
    ],
    "features": [
      "chat/history 轮询收信（3~5 秒级延迟，断线自动重试）",
      "webhook 接口回信（带会话续接与重试）",
      "访客身份访问控制（open/allowlist/pairing/disabled）",
      "CLI setup 向导（--digital-human-id/--webhook-token 等）"
    ],
    "documentation": "README.md"
  }
}
